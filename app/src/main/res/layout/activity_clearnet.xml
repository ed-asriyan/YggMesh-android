<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8pt"
        android:text="@string/clearnet_title"
        android:textColor="?attr/textDefault"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="8pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="2pt"
                        android:alpha="0.7"
                        android:text="@string/clearnet_mode"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8pt"
                        android:layout_marginEnd="8pt"
                        android:background="@drawable/rounded"
                        android:divider="#46878787"
                        android:dividerPadding="4pt"
                        android:paddingLeft="4pt"
                        android:paddingTop="2pt"
                        android:paddingRight="4pt"
                        android:paddingBottom="2pt"
                        android:showDividers="middle">

                        <TableRow
                            android:id="@+id/clearnetModePanel"
                            style="@style/SelectableItemStyle">

                            <TextView
                                android:id="@+id/clearnetModeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/textDefault" />
                        </TableRow>

                        <TextView
                            android:id="@+id/clearnetStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="4pt"
                            android:paddingTop="2pt"
                            android:paddingEnd="4pt"
                            android:paddingBottom="4pt"
                            android:alpha="0.7"
                            android:fontFamily="monospace"
                            android:text="@string/nearby_mesh_off"
                            android:textIsSelectable="true"
                            android:textSize="11sp" />
                    </TableLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="4pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="4pt"
                        android:alpha="0.7"
                        android:paddingRight="8pt"
                        android:text="@string/clearnet_mode_hint"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="8pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="2pt"
                        android:alpha="0.7"
                        android:text="@string/clearnet_exits"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8pt"
                        android:layout_marginEnd="8pt"
                        android:background="@drawable/rounded"
                        android:divider="#46878787"
                        android:dividerPadding="4pt"
                        android:paddingLeft="4pt"
                        android:paddingTop="2pt"
                        android:paddingRight="4pt"
                        android:paddingBottom="2pt"
                        android:showDividers="middle">

                        <TableLayout
                            android:id="@+id/clearnetExitsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:divider="#46878787"
                            android:showDividers="middle" />

                        <TableRow
                            android:id="@+id/addClearnetExitPanel"
                            style="@style/SelectableItemStyle">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/clearnet_add_exit"
                                android:textColor="?attr/textDefault" />
                        </TableRow>
                    </TableLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="4pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="4pt"
                        android:alpha="0.7"
                        android:paddingRight="8pt"
                        android:text="@string/clearnet_exits_hint"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="8pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="2pt"
                        android:alpha="0.7"
                        android:text="@string/clearnet_your_key"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8pt"
                        android:layout_marginEnd="8pt"
                        android:background="@drawable/rounded"
                        android:divider="#46878787"
                        android:dividerPadding="4pt"
                        android:paddingLeft="4pt"
                        android:paddingTop="2pt"
                        android:paddingRight="4pt"
                        android:paddingBottom="2pt"
                        android:showDividers="middle">

                        <TableRow
                            android:id="@+id/clearnetPublicKeyPanel"
                            style="@style/SelectableItemStyle">

                            <TextView
                                android:id="@+id/clearnetPublicKey"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:textColor="?attr/textDefault"
                                android:textSize="12sp" />
                        </TableRow>
                    </TableLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16pt"
                        android:layout_marginLeft="16pt"
                        android:layout_marginTop="4pt"
                        android:layout_marginEnd="8pt"
                        android:layout_marginRight="8pt"
                        android:layout_marginBottom="4pt"
                        android:alpha="0.7"
                        android:paddingRight="8pt"
                        android:text="@string/clearnet_your_key_hint"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
